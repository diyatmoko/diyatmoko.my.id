# One-time example for your EXISTING public Docker Nginx.
# Obtain this domain's certificate using your existing ACME process first.
# Match the webroot/certificate paths to the volumes mounted in that container.
# Install as a NEW virtual host; do not replace unrelated virtual hosts.
server {
    listen 80;
    server_name diyatmoko.my.id;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://diyatmoko.my.id$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name diyatmoko.my.id;
    ssl_certificate /etc/letsencrypt/live/diyatmoko.my.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/diyatmoko.my.id/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        # Docker DNS re-resolves the service when a rollout changes its container IP.
        resolver 127.0.0.11 valid=5s ipv6=off;
        set $portfolio_upstream diyatmoko-portfolio:8080;
        proxy_pass http://$portfolio_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}

# For host Nginx, remove resolver/set and use proxy_pass http://127.0.0.1:18080;
